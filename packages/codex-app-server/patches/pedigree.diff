+
+fn current_exe_path() -> std::io::Result<PathBuf> {
+    match std::env::current_exe() {
+        Ok(path) => Ok(path),
+        Err(error) => {
+            // Pedigree lacks /proc/self/exe; its package launcher supplies an
+            // absolute argv[0] so child helpers can re-execute the same binary.
+            #[cfg(feature = "pedigree")]
+            if let Some(path) = std::env::args_os().next().map(PathBuf::from)
+                && path.is_absolute()
+                && path.is_file()
+            {
+                return Ok(path);
+            }
+            Err(error)
+        }
+    }
 }
 
