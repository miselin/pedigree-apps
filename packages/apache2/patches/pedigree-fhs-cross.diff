diff --git a/config.layout b/config.layout
index 6a76e5a..b381a31 100644
--- a/config.layout
+++ b/config.layout
@@ -323,6 +323,31 @@
     errordir:      ${datadir}/error
 </Layout>
 
+# Pedigree follows the Filesystem Hierarchy Standard. Runtime state is kept
+# out of /usr so the installed package can live on a read-only system image.
+<Layout Pedigree>
+    prefix:          /usr
+    exec_prefix:     ${prefix}
+    bindir:          ${prefix}/bin
+    sbindir:         ${prefix}/sbin
+    libdir:          ${prefix}/lib
+    libexecdir:      ${prefix}/lib/apache2/modules
+    installbuilddir: ${prefix}/share/apache2/build
+    mandir:          ${prefix}/share/man
+    sysconfdir:      /etc/apache2
+    datadir:         ${prefix}/share/apache2
+    iconsdir:        ${datadir}/icons
+    htdocsdir:       /var/www/htdocs
+    manualdir:       ${datadir}/manual
+    cgidir:          /var/www/cgi-bin
+    errordir:        ${datadir}/error
+    includedir:      ${prefix}/include/apache2
+    localstatedir:   /var
+    runtimedir:      ${localstatedir}/run/apache2
+    logfiledir:      ${localstatedir}/log/apache2
+    proxycachedir:   ${localstatedir}/cache/apache2
+</Layout>
+
 # Generic RPM layout
 <Layout RPM>
     prefix:        /usr
