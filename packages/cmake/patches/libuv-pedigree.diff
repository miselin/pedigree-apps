diff --git a/Utilities/cmlibuv/src/unix/pedigree.c b/Utilities/cmlibuv/src/unix/pedigree.c
new file mode 100644
index 000000000..c789b34bc
--- /dev/null
+++ b/Utilities/cmlibuv/src/unix/pedigree.c
@@ -0,0 +1,42 @@
+/* Minimal platform services for libuv's portable poll backend on Pedigree. */
+
+#include "uv.h"
+#include "internal.h"
+
+#include <errno.h>
+#include <sys/resource.h>
+#include <time.h>
+
+int uv_resident_set_memory(size_t* rss) {
+  struct rusage usage;
+
+  if (getrusage(RUSAGE_SELF, &usage) < 0)
+    return UV__ERR(errno);
+
+  *rss = usage.ru_maxrss * 1024;
+  return 0;
+}
+
+int uv_uptime(double* uptime) {
+  struct timespec now;
+
+  if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+    return UV__ERR(errno);
+
+  *uptime = now.tv_sec + now.tv_nsec / 1e9;
+  return 0;
+}
+
+int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
+  *cpu_infos = NULL;
+  *count = 0;
+  return UV_ENOSYS;
+}
+
+uint64_t uv_get_constrained_memory(void) {
+  return 0;
+}
+
+uint64_t uv_get_available_memory(void) {
+  return uv_get_free_memory();
+}
