+        # real permission error, and native Pedigree Perl keeps this check.
+        return 1 if $^O eq 'linux' && $Config{osname} eq 'pedigree' &&
+                    -d $dir;
         unless (defined $has_posix) {
             $has_posix = (!_Is_cygwin && !_Is_Win32
              && eval { local $^W; require POSIX; 1} ) || 0;
