diff --git a/configure b/configure
index 847f50b..b3241af 100755
--- a/configure
+++ b/configure
@@ -6059,7 +6059,7 @@ SLANG_DLL_CFLAGS=""
 M_LIB="-lm"
 
 case "$host_os" in
-  *linux*|*gnu*|k*bsd*-gnu )
+  *linux*|*gnu*|*pedigree*|k*bsd*-gnu )
     DYNAMIC_LINK_FLAGS="-Wl,-export-dynamic"
     ELF_CC="\$(CC)"
     ELF_CFLAGS="\$(CFLAGS) \$(CPPFLAGS) -fPIC"
@@ -6996,5 +6996,11 @@ do
    fi
 done
+case "$host_os" in
+  *pedigree*)
+    MISC_TERMINFO_DIRS="/usr/share/terminfo"
+    TERMCAP=""
+    ;;
+esac
 if test "$TERMCAP"; then
   { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
 $as_echo "no" >&6; }
