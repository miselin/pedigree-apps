diff --git a/Modules/timemodule.c b/Modules/timemodule.c
--- a/Modules/timemodule.c
+++ b/Modules/timemodule.c
@@ -1339,12 +1339,14 @@ py_process_time(time_module_state *state, PyTime_t *tp,
 // gh-115714: Don't use CLOCK_PROCESS_CPUTIME_ID on WASI.
 /* CLOCK_PROF is defined on NetBSD, but not supported.
  * CLOCK_PROCESS_CPUTIME_ID is broken on NetBSD for the same reason as
- * CLOCK_THREAD_CPUTIME_ID (see comment below).
+ * CLOCK_THREAD_CPUTIME_ID (see comment below). Pedigree only implements
+ * CLOCK_REALTIME and CLOCK_MONOTONIC.
  */
 #if defined(HAVE_CLOCK_GETTIME) \
     && (defined(CLOCK_PROCESS_CPUTIME_ID) || defined(CLOCK_PROF)) \
     && !defined(__wasi__) \
-    && !defined(__NetBSD__)
+    && !defined(__NetBSD__) \
+    && !defined(__PEDIGREE__)
     struct timespec ts;
 
     if (HAVE_CLOCK_GETTIME_RUNTIME) {
@@ -1543,10 +1543,12 @@
  * https://github.com/python/cpython/issues/123978
  * https://gnats.netbsd.org/57512
  */
+/* Pedigree defines the clock ID for ABI compatibility, but its clock_gettime()
+ * implementation does not support per-thread CPU clocks yet. */
 #elif defined(HAVE_CLOCK_GETTIME) && \
       defined(CLOCK_THREAD_CPUTIME_ID) && \
       !defined(__EMSCRIPTEN__) && !defined(__wasi__) && \
-      !defined(__NetBSD__)
+      !defined(__NetBSD__) && !defined(__PEDIGREE__)
 #define HAVE_THREAD_TIME
 
 #if defined(__APPLE__) && _Py__has_attribute(availability)
diff --git a/Python/pytime.c b/Python/pytime.c
--- a/Python/pytime.c
+++ b/Python/pytime.c
@@ -955,16 +955,20 @@ py_get_system_clock(PyTime_t *tp, _Py_clock_info_t *info, int raise_exc)
     }
 
     if (info) {
-        struct timespec res;
         info->implementation = "clock_gettime(CLOCK_REALTIME)";
         info->monotonic = 0;
         info->adjustable = 1;
+#ifdef HAVE_CLOCK_GETRES
+        struct timespec res;
         if (clock_getres(CLOCK_REALTIME, &res) == 0) {
             info->resolution = (double)res.tv_sec + (double)res.tv_nsec * 1e-9;
         }
         else {
             info->resolution = 1e-9;
         }
+#else
+        info->resolution = 1e-9;
+#endif
     }
 
 #ifdef HAVE_CLOCK_GETTIME_RUNTIME
@@ -1207,12 +1211,16 @@ py_get_monotonic_clock(PyTime_t *tp, _Py_clock_info_t *info, int raise_exc)
         info->monotonic = 1;
         info->implementation = implementation;
         info->adjustable = 0;
+#ifdef HAVE_CLOCK_GETRES
         struct timespec res;
         if (clock_getres(clk_id, &res) != 0) {
             PyErr_SetFromErrno(PyExc_OSError);
             return -1;
         }
         info->resolution = res.tv_sec + res.tv_nsec * 1e-9;
+#else
+        info->resolution = 1e-9;
+#endif
     }
 #endif
     return 0;
