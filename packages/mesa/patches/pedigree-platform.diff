-  if cc.check_header(h)
+  if h not in pedigree_unavailable_headers and cc.check_header(h)
     pre_args += '-DHAVE_@0@'.format(h.to_upper().underscorify())
   endif
 endforeach
@@ -1420,7 +1427,7 @@
 }
 
 foreach f, prefix: functions_to_detect
-  if cc.has_function(f, prefix: prefix)
+  if f not in pedigree_unavailable_functions and cc.has_function(f, prefix: prefix)
     pre_args += '-DHAVE_@0@'.format(f.to_upper())
   endif
 endforeach
@@ -1603,7 +1610,7 @@
 endif
