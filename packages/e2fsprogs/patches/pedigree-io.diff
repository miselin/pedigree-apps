--- a/lib/ext2fs/tdb.c
+++ b/lib/ext2fs/tdb.c
@@ -61,6 +61,54 @@
 #include <sys/file.h>
 #include <fcntl.h>
 
+#ifndef HAVE_PREAD
+static ssize_t tdb_pread(int fd, void *buf, size_t count, off_t offset)
+{
+	off_t current_offset;
+	ssize_t result;
+	int saved_errno;
+
+	/* Preserve the descriptor offset expected from positioned I/O. */
+	current_offset = lseek(fd, 0, SEEK_CUR);
+	if (current_offset == (off_t)-1 ||
+	    lseek(fd, offset, SEEK_SET) == (off_t)-1)
+		return -1;
+	result = read(fd, buf, count);
+	saved_errno = errno;
+	if (lseek(fd, current_offset, SEEK_SET) == (off_t)-1)
+		return -1;
+	if (result < 0)
+		errno = saved_errno;
+	return result;
+}
+#else
+#define tdb_pread pread
+#endif
+
+#ifndef HAVE_PWRITE
+static ssize_t tdb_pwrite(int fd, const void *buf, size_t count, off_t offset)
+{
+	off_t current_offset;
+	ssize_t result;
+	int saved_errno;
+
+	/* Preserve the descriptor offset expected from positioned I/O. */
+	current_offset = lseek(fd, 0, SEEK_CUR);
+	if (current_offset == (off_t)-1 ||
+	    lseek(fd, offset, SEEK_SET) == (off_t)-1)
+		return -1;
+	result = write(fd, buf, count);
+	saved_errno = errno;
+	if (lseek(fd, current_offset, SEEK_SET) == (off_t)-1)
+		return -1;
+	if (result < 0)
+		errno = saved_errno;
+	return result;
+}
+#else
+#define tdb_pwrite pwrite
+#endif
+
 #ifdef HAVE_SYS_MMAN_H
 #include <sys/mman.h>
 #endif
